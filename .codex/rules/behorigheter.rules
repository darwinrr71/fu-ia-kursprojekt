
# Tillåt läsning av Git-status och ändringar.
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
)

# Kräv godkännande innan en commit skapas.
prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
)

# Blockera publicering och destruktiv återställning.
prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Publicering kräver ett separat godkänt arbetsflöde.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Använd en icke-destruktiv metod för att hantera ändringar.",
)

# Tillåt automatiska kvalitetskontroller.
prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
)

prefix_rule(
    pattern = ["npm", "run", "typecheck"],
    decision = "allow",
)

# Kräv godkännande innan filer läggs till i Git.
prefix_rule(
    pattern = ["git", "add"],
    decision = "prompt",
)

# Blockera direkta borttagningskommandon.
prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Borttagning kräver särskild granskning.",
)

prefix_rule(
    pattern = ["Remove-Item"],
    decision = "forbidden",
    justification = "Borttagning kräver särskild granskning.",
)